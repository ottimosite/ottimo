{
  "name": "ottimo",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-local.mjs",
    "dev:vite": "vite",
    "dev:functions": "npx --yes netlify-cli@27.8.0 functions:serve",
    "build": "tsc -b && vite build && node scripts/generate-public-pages.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "test:performance": "node scripts/check-public-performance-budget.mjs",
    "test:css-architecture": "node scripts/check-css-architecture.mjs",
    "test:security": "vitest run src/security src/services/persistence.test.ts src/services/authenticated-repository.test.ts src/services/supabase-auth.test.ts src/services/supabase-email-auth.test.ts netlify/functions/auth-*.test.mts",
    "build:e2e": "tsc -b && vite build --mode e2e && node scripts/generate-public-pages.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.0",
    "@sparticuz/chromium": "^149.0.0",
    "axe-core": "^4.10.3",
    "playwright": "^1.55.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^6.1.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "jsdom": "^26.1.0",
    "supabase": "^2.117.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild": true
  }
}
