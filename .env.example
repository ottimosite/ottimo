# Ottimo environment variables
# The local demo does not require any environment variables.
# Add integration-specific variables here only as non-secret placeholders.

# Supabase server boundary
# Public project URL; safe to expose only where the client flow requires it.
SUPABASE_URL=https://your-project.supabase.co
# Server-only privileged key. Never expose this to the browser or commit a real value.
SUPABASE_SECRET_KEY=
